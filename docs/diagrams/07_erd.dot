digraph ERD {
  rankdir=LR; nodesep=0.6;
  graph [fontname="Inter", fontsize=12, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5];
  node  [fontname="Inter", fontsize=11, color="#18181B", fontcolor="#18181B"];
  edge  [fontname="Inter", fontsize=9, color="#6B6B74", fontcolor="#6B6B74", arrowsize=0.7];
  node [shape=plain];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#18181B"><TR><TD BGCOLOR="#D7263D"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><b>PK</b> id INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">username TEXT UNIQUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">password TEXT (salt$hash)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">full_name TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">email TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">role TEXT (user | admin)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">is_banned INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">failed_count INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">locked_until TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">last_login_at TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">created_at, updated_at TEXT</TD></TR></TABLE>>];
  login_history [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#18181B"><TR><TD BGCOLOR="#D7263D"><FONT COLOR="white"><B>login_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><b>PK</b> id INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><b>FK</b> user_id → users.id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">username TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">success INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">reason TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">created_at TEXT</TD></TR></TABLE>>];
  searches [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#18181B"><TR><TD BGCOLOR="#D7263D"><FONT COLOR="white"><B>searches</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><b>PK</b> id INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><b>FK</b> user_id → users.id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">manufacturer, model_base TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">year INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">odometer REAL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">budget_max_usd REAL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">predicted_price, price_low, price_high REAL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">n_matches INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">success INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">elapsed_ms REAL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">input_json TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">result_json TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">created_at TEXT</TD></TR></TABLE>>];
  favorites [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#18181B"><TR><TD BGCOLOR="#D7263D"><FONT COLOR="white"><B>favorites</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><b>PK</b> id INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><b>FK</b> user_id → users.id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">listing_id INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">car_json TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">note TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">created_at TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">UNIQUE (user_id, listing_id)</TD></TR></TABLE>>];
  audit_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#18181B"><TR><TD BGCOLOR="#D7263D"><FONT COLOR="white"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><b>PK</b> id INTEGER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><b>FK</b> admin_id → users.id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">action TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">target TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">detail TEXT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">created_at TEXT</TD></TR></TABLE>>];
  edge [arrowhead=crow, arrowtail=tee, dir=both, color="#18181B"];
  users -> login_history [label="1 – n"];
  users -> searches [label="1 – n"];
  users -> favorites [label="1 – n"];
  users -> audit_log [label="1 – n (admin)"];
}
