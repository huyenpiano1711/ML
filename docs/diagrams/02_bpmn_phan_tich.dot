digraph BpmnAnalysis {
  rankdir=LR; newrank=true; compound=true;
  graph [fontname="Inter", fontsize=12, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5];
  node  [fontname="Inter", fontsize=11, color="#18181B", fontcolor="#18181B"];
  edge  [fontname="Inter", fontsize=9, color="#6B6B74", fontcolor="#6B6B74", arrowsize=0.7];
  label=<<B>BPMN 1 – Ước tính giá và tìm xe phù hợp</B>>; labelloc=t; fontsize=14;
  subgraph cluster_U { label=<<B>Người dùng</B>>; labeljust=l; style="filled"; fillcolor="#F5F5F7"; color="#D4D4DA";
    s [shape=circle, width=0.35, label="", style=filled, fillcolor="white", penwidth=1.5];
    u1 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Nhập thông số xe
và ngân sách"];
    u2 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Bấm ANALYZE &
FIND CARS"];
    u3 [shape=diamond, style=filled, fillcolor="#FDE8EB", color="#D7263D", width=0.55, height=0.55, fixedsize=true, fontsize=14, label="+"];
    u4 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Xem chi tiết /
lưu xe / so sánh"];
    u5 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Xuất PDF"];
    e [shape=doublecircle, width=0.3, label="", style=filled, fillcolor="#18181B"];
  }
  subgraph cluster_G { label=<<B>Giao diện PyQt6</B>>; labeljust=l; style="filled"; fillcolor="#F5F5F7"; color="#D4D4DA";
    g1 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Kiểm tra dữ liệu nhập
(bắt buộc, khoảng, dòng xe,
số dặm hợp lý)"];
    g2 [shape=diamond, style=filled, fillcolor="#FDE8EB", color="#D7263D", width=0.55, height=0.55, fixedsize=true, fontsize=14, label="×"];
    g3 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Hiện lỗi cụ thể
từng ô"];
    g4 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Hiển thị giá, ngân sách,
Top 5, xe cùng giá"];
  }
  subgraph cluster_B { label=<<B>Backend (app_service)</B>>; labeljust=l; style="filled"; fillcolor="#F5F5F7"; color="#D4D4DA";
    b1 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="VehicleInput.check()"];
    b2 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Dự đoán giá +
khoảng giá 80%"];
    b3 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Lọc ngân sách,
KNN xếp hạng Top 5"];
    b4 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Tìm xe cùng mức giá
+ gắn ảnh"];
  }
  subgraph cluster_D { label=<<B>CSDL / Mô hình</B>>; labeljust=l; style="filled"; fillcolor="#F5F5F7"; color="#D4D4DA";
    d1 [shape=cylinder, style=filled, fillcolor="#F5F5F7", width=1.1, label="final_pipeline
.joblib"];
    d2 [shape=cylinder, style=filled, fillcolor="#F5F5F7", width=1.1, label="recommendation
_catalog.pkl"];
    d3 [shape=cylinder, style=filled, fillcolor="#F5F5F7", width=1.1, label="SQLite:
searches"];
  }
  s -> u1;
  u1 -> u2;
  u2 -> g1;
  g1 -> g2;
  g2 -> g3 [label="không hợp lệ"];
  g3 -> u1;
  g2 -> b1 [label="hợp lệ"];
  b1 -> b2;
  d1 -> b2 [style=dashed];
  b2 -> b3;
  d2 -> b3 [style=dashed];
  b3 -> b4;
  b4 -> g4;
  g4 -> d3 [label="lưu lịch sử", style=dashed];
  g4 -> u3;
  u3 -> u4;
  u3 -> u5;
  u4 -> e;
  u5 -> e;
}
