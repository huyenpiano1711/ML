    UC05 [label="UC05
Đổi mật khẩu", shape=ellipse, style=filled, fillcolor="white", width=2.1, height=0.75];
   }
   subgraph cluster_605 { label="Quản trị viên"; style="rounded,dashed"; color="#BDBDC5"; fontcolor="#6B6B74";
    UC11 [label="UC11
Xem dashboard
