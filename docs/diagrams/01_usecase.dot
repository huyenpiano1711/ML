Xuất kết quả PDF", shape=ellipse, style=filled, fillcolor="#FFF5F6", width=2.1, height=0.75];
   }
   subgraph cluster_594 { label="Chức năng chung (User và Admin)"; style="rounded,dashed"; color="#BDBDC5"; fontcolor="#6B6B74";
    UC01 [label="UC01
Đăng ký tài khoản", shape=ellipse, style=filled, fillcolor="white", width=2.1, height=0.75];
    UC02 [label="UC02
Đăng nhập", shape=ellipse, style=filled, fillcolor="white", width=2.1, height=0.75];
