digraph UseCase {
  rankdir=LR; nodesep=0.18; ranksep=1.1; splines=true;
  graph [fontname="Inter", fontsize=12, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5];
  node  [fontname="Inter", fontsize=11, color="#18181B", fontcolor="#18181B"];
  edge  [fontname="Inter", fontsize=9, color="#6B6B74", fontcolor="#6B6B74", arrowsize=0.7];
  User  [label="«actor»\nNgười dùng", shape=box, style="rounded,filled,bold", fillcolor="#FDE8EB", color="#D7263D", width=1.3, height=0.9];
  Admin [label="«actor»\nQuản trị viên", shape=box, style="rounded,filled,bold", fillcolor="#18181B", color="#18181B", width=1.3, height=0.9, fontcolor="white"];
  ML    [label="«system»\nMô hình giá\n+ Hệ gợi ý", shape=box, style="rounded,dashed", width=1.3];
  subgraph cluster_sys { label=<<B>Hệ thống AutoWise AI</B>>; labeljust=l; style="rounded"; color="#D7263D"; penwidth=1.6;
   subgraph cluster_524 { label="Người dùng"; style="rounded,dashed"; color="#BDBDC5"; fontcolor="#6B6B74";
    UC06 [label="UC06
Ước tính giá và
tìm xe phù hợp", shape=ellipse, style=filled, fillcolor="#FFF5F6", width=2.1, height=0.75];
