digraph Arch {
  rankdir=TB; nodesep=0.3; ranksep=0.45;
  graph [fontname="Inter", fontsize=12, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5];
  node  [fontname="Inter", fontsize=11, color="#18181B", fontcolor="#18181B"];
  edge  [fontname="Inter", fontsize=9, color="#6B6B74", fontcolor="#6B6B74", arrowsize=0.7];
  node [shape=box, style="rounded,filled", fillcolor="white", width=1.6];
  subgraph cluster_ui { label=<<B>Tầng giao diện (desktop_app/UI – .ui → pyuic6 → *Ex.py)</B>>; labeljust=l; style="rounded,filled"; fillcolor="#FFF5F6"; color="#D4D4DA";
    ui0 [label="Login
MainWindowEx"];
    ui1 [label="AutoWise
MainWindowEx"];
    ui2 [label="UserDialogsEx
(Account, History,
Favorites, Compare)"];
    ui3 [label="Admin
MainWindowEx"];
    ui4 [label="CarDetails
DialogEx"];
  }
  subgraph cluster_ctl { label=<<B>Tầng điều khiển và tiện ích (controllers/, utils/)</B>>; labeljust=l; style="rounded,filled"; fillcolor="white"; color="#D4D4DA";
    ctl0 [label="vehicle_controller"];
    ctl1 [label="results_controller"];
    ctl2 [label="ChartUtil / TableUtil
/ PdfUtil / UIUtil"];
  }
  subgraph cluster_dal { label=<<B>Tầng truy cập dữ liệu (dal/, connectors/, models/)</B>>; labeljust=l; style="rounded,filled"; fillcolor="#F5F5F7"; color="#D4D4DA";
    dal0 [label="UserDao, AuditDao"];
    dal1 [label="SearchDao, FavoriteDao,
StatsDao"];
    dal2 [label="Connector
(SQLite)"];
  }
  subgraph cluster_be { label=<<B>Backend (backend/)</B>>; labeljust=l; style="rounded,filled"; fillcolor="white"; color="#D4D4DA";
    be0 [label="app_service.analyze()"];
    be1 [label="prediction_service"];
    be2 [label="recommendation_service"];
    be3 [label="alternative_service"];
    be4 [label="image_service"];
  }
  subgraph cluster_ml { label=<<B>Học máy và dữ liệu (src/, scripts/, models/)</B>>; labeljust=l; style="rounded,filled"; fillcolor="#F5F5F7"; color="#D4D4DA";
    ml0 [label="model_trainer
(train, validate, registry)"];
    ml1 [label="Recommender (KNN)"];
    ml2 [label="final_pipeline.joblib
registry.json", shape=cylinder];
    ml3 [label="recommendation_catalog.pkl", shape=cylinder];
    ml4 [label="autowise.sqlite", shape=cylinder];
  }
  edge [color="#D7263D"];
  ui1 -> ctl0;
  ui1 -> ctl1;
  ctl1 -> be0;
  ui2 -> dal1;
  ui0 -> dal0;
  ui3 -> dal0;
  ui3 -> dal1;
  ui3 -> ml0;
  dal0 -> dal2;
  dal1 -> dal2;
  dal2 -> ml4;
  be0 -> be1;
  be0 -> be2;
  be0 -> be3;
  be0 -> be4;
  be1 -> ml2;
  be2 -> ml1;
  ml1 -> ml3;
  ml0 -> ml2;
  ui1 -> dal1;
}
