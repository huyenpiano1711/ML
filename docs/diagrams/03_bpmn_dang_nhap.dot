digraph BpmnLogin {
  rankdir=LR; newrank=true; compound=true;
  graph [fontname="Inter", fontsize=12, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5];
  node  [fontname="Inter", fontsize=11, color="#18181B", fontcolor="#18181B"];
  edge  [fontname="Inter", fontsize=9, color="#6B6B74", fontcolor="#6B6B74", arrowsize=0.7];
  label=<<B>BPMN 2 – Đăng nhập và phân quyền</B>>; labelloc=t; fontsize=14;
  subgraph cluster_U { label=<<B>Người dùng / Quản trị viên</B>>; labeljust=l; style="filled"; fillcolor="#F5F5F7"; color="#D4D4DA";
    s [shape=circle, width=0.35, label="", style=filled, fillcolor="white", penwidth=1.5];
    u1 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Nhập username
và mật khẩu"];
    e1 [shape=doublecircle, width=0.3, label="", style=filled, fillcolor="#18181B"];
    e2 [shape=doublecircle, width=0.3, label="", style=filled, fillcolor="#18181B"];
  }
  subgraph cluster_G { label=<<B>Cửa sổ đăng nhập</B>>; labeljust=l; style="filled"; fillcolor="#F5F5F7"; color="#D4D4DA";
    g1 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Tìm tài khoản,
kiểm tra khóa 5 phút"];
    g2 [shape=diamond, style=filled, fillcolor="#FDE8EB", color="#D7263D", width=0.55, height=0.55, fixedsize=true, fontsize=14, label="×"];
    g3 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="So mật khẩu băm
PBKDF2 + muối"];
    g4 [shape=diamond, style=filled, fillcolor="#FDE8EB", color="#D7263D", width=0.55, height=0.55, fixedsize=true, fontsize=14, label="×"];
    g5 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Tăng số lần sai;
đủ 3 lần → khóa 5 phút"];
    g6 [shape=diamond, style=filled, fillcolor="#FDE8EB", color="#D7263D", width=0.55, height=0.55, fixedsize=true, fontsize=14, label="×"];
    g7 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Báo lỗi,
số lần còn lại"];
    g8 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Thông báo và
thoát ứng dụng"];
    g9 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Đặt lại bộ đếm,
ghi lần đăng nhập"];
    g10 [shape=diamond, style=filled, fillcolor="#FDE8EB", color="#D7263D", width=0.55, height=0.55, fixedsize=true, fontsize=14, label="×"];
    g11 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Mở Admin console"];
    g12 [shape=box, style="rounded,filled", fillcolor="white", width=1.7, height=0.6, label="Mở màn hình
tư vấn xe"];
  }
  subgraph cluster_D { label=<<B>CSDL SQLite</B>>; labeljust=l; style="filled"; fillcolor="#F5F5F7"; color="#D4D4DA";
    d1 [shape=cylinder, style=filled, fillcolor="#F5F5F7", width=1.1, label="users"];
    d2 [shape=cylinder, style=filled, fillcolor="#F5F5F7", width=1.1, label="login_history"];
  }
  s -> u1;
  u1 -> g1;
  d1 -> g1 [style=dashed];
  g1 -> g2;
  g2 -> g7 [label="đang khóa /
bị cấm"];
  g2 -> g3 [label="được phép"];
  g3 -> g4;
  g4 -> g5 [label="sai"];
  g5 -> d1 [style=dashed];
  g5 -> g6;
  g6 -> g7 [label="< 3 lần
trong phiên"];
  g6 -> g8 [label="3 lần liên tiếp"];
  g7 -> u1;
  g8 -> e1;
  g4 -> g9 [label="đúng"];
  g9 -> d2 [style=dashed];
  g9 -> g10;
  g10 -> g11 [label="admin"];
  g10 -> g12 [label="user"];
  g11 -> e2;
  g12 -> e2;
}
