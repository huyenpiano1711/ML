QMainWindow, QWidget {
    background: #F7F8FA;
    color: #111827;
    font-family: "Segoe UI";
    font-size: 13px;
}
QFrame#header {
    background: #111827;
}
QLabel#logo {
    background: transparent;
    color: white;
    font-size: 22px;
    font-weight: bold;
}
QLabel#stepIndicator {
    background: transparent;
    color: #FCA5A5;
    font-weight: bold;
}
QLabel[heading="true"] {
    font-size: 24px;
    font-weight: bold;
    color: #111827;
}
QLabel[section="true"] {
    font-size: 17px;
    font-weight: bold;
}
QLabel[muted="true"] {
    color: #6B7280;
}
QFrame[card="true"] {
    background: white;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}
QLineEdit, QComboBox, QSpinBox {
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    background: white;
    min-height: 28px;
    padding: 7px;
}
QPushButton {
    background: #C91E32;
    color: white;
    border-radius: 8px;
    border: none;
    padding: 12px;
    font-weight: bold;
}
QPushButton:hover {
    background: #A91A2B;
}
QPushButton[secondary="true"] {
    background: #E5E7EB;
    color: #111827;
}
QGroupBox {
    font-weight: bold;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    margin-top: 15px;
    padding-top: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
}
QScrollArea {
    border: none;
}
</string>
