      "name": "miles_per_year",
      "source": "derived",
      "dtype": "numeric",
      "derived_from": [
        "odometer",
        "year"
      ],
      "formula": "odometer / max(1, car_age)",
      "used_in": [
        "price"
      ]
    },
    {
      "name": "cylinders_num",
      "source": "derived",
      "dtype": "numeric",
      "derived_from": [
        "cylinders"
      ],
      "formula": "số trong chuỗi cylinders ('6 cylinders' -> 6), 'unknown' -> NaN",
      "used_in": [
        "price"
      ]
    },
    {
      "name": "condition_rank",
      "source": "derived",
      "dtype": "numeric",
      "derived_from": [
        "condition"
      ],
      "formula": "bảng thứ bậc {'salvage': 0, 'fair': 1, 'good': 2, 'excellent': 3, 'like new': 4, 'new': 5}, 'unknown' -> NaN",
      "used_in": [
        "price"
      ]
    },
    {
      "name": "brand_tier",
      "source": "derived",
      "dtype": "categorical",
      "derived_from": [
        "manufacturer"
      ],
      "formula": "exotic / luxury / mainstream theo danh sách hãng",
      "used_in": [
        "price"
      ]
    },
    {
      "name": "make_model",
      "source": "derived",
      "dtype": "categorical",
      "derived_from": [
        "manufacturer",
        "model_base"
      ],
      "formula": "manufacturer + ' ' + model_base",
      "used_in": [
        "price"
      ]
    }
  ],
