{
  "schema_version": "1.0",
  "created": "2026-11-11",
  "data_file": "data/processed/vehicles_filled.pkl",
  "split_files": [
    "data/splits/train_ids.csv",
    "data/splits/val_ids.csv",
    "data/splits/test_ids.csv"
  ],
  "values_computed_on": "train split",
  "target": {
    "name": "log_price",
    "formula": "log(1 + price)",
    "inverse": "np.expm1(prediction)",
    "unit": "USD"
  },
  "price_model_columns": {
    "numeric": [
      "car_age",
      "odometer",
      "log_odometer",
      "miles_per_year",
      "cylinders_num",
      "condition_rank"
    ],
    "categorical": [
      "manufacturer",
      "type",
      "condition",
      "fuel",
      "transmission",
      "drive",
      "paint_color",
      "title_status",
      "state",
      "brand_tier"
    ],
    "high_cardinality": [
      "make_model"
    ],
    "all": [
      "car_age",
      "odometer",
      "log_odometer",
      "miles_per_year",
      "cylinders_num",
      "condition_rank",
      "manufacturer",
      "type",
      "condition",
      "fuel",
      "transmission",
      "drive",
      "paint_color",
      "title_status",
      "state",
      "brand_tier",
      "make_model"
    ]
  },
  "recommendation_columns": {
    "hard_filters": {
      "price": "price <= budget_max_usd"
    },
    "similarity_numeric": [
      "price",
      "car_age",
      "odometer"
    ],
    "similarity_categorical": [
      "type",
      "fuel",
      "transmission",
      "drive",
      "condition",
      "manufacturer"
    ],
    "display": [
      "id",
      "manufacturer",
      "model_base",
      "year",
      "price",
      "odometer",
      "type",
      "condition",
      "fuel",
      "transmission",
      "title_status",
      "state",
      "image_path"
    ],
    "note": "image_path do C01 tạo khi ghép ảnh; trọng số từng cột do C03 quyết định"
  },
